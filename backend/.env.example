NODE_ENV=development
PORT=3000
# Desarrollo local: Postgres del docker-compose se expone en localhost:5433
DATABASE_URL="postgresql://taskforge:taskforge@localhost:5433/taskforge?schema=public"
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:*
