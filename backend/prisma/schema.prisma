generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  COMMENT
  MENTION
  SYSTEM
}

/// Evidencia fotográfica before/after en adjuntos de tarea.
enum EvidenceKind {
  BEFORE
  AFTER
}

enum EmploymentType {
  PART_TIME
  FULL_TIME
  FULL_TIME_SEASONAL
}

/// Tenant raíz: usuarios, roles, datos y branding aislados por organización.
model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  customCss      String?
  /// JSON: idioma, límites, flags de funcionalidad, integraciones, etc.
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  roles       Role[]
  users       User[]
  departments Department[]
  teams       Team[]
  projects    Project[]
  boards      Board[]
  assets      Asset[]
  assetCategories AssetCategoryOption[]
  assetStatuses   AssetStatusOption[]
  activityLogs ActivityLog[]
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Nombre visible (puede ser custom). Los roles de sistema usan ADMIN, MANAGER, etc.
  name           String
  /// Claves PermissionKey persistidas (ej. users:read).
  permissions    String[]     @default([])
  /// Roles sembrados al crear la org; no se pueden eliminar.
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teams          Team[]
  users          User[]
  projects       Project[]

  @@index([organizationId])
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  members        TeamMember[]

  @@index([organizationId])
  @@index([departmentId])
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  isActive       Boolean        @default(true)
  employmentType EmploymentType @default(FULL_TIME)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teamMembers    TeamMember[]
  refreshTokens  RefreshToken[]
  tasksCreated   Task[]       @relation("TaskCreatedBy")
  tasksAssigned  Task[]       @relation("TaskAssignee")
  comments       TaskComment[]
  attachments    Attachment[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  ownedProjects  Project[]    @relation("ProjectOwner")
  assetHistory   AssetHistory[]
  assetPhotos    AssetPhoto[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?
  platform  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, clientId])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner            User?        @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  boards         Board[]

  @@index([organizationId])
}

model Board {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tasks          Task[]

  @@index([projectId])
  @@index([organizationId])
}

model Task {
  id           String         @id @default(cuid())
  title        String
  description  String?
  boardId      String
  board        Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  parentTaskId String?
  parentTask   Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]         @relation("TaskSubtasks")
  status       TaskStatus     @default(BACKLOG)
  priority     TaskPriority   @default(MEDIUM)
  assigneeId   String?
  assignee     User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  location     String?
  dueDate      DateTime?
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  comments     TaskComment[]
  attachments  Attachment[]
  activity     ActivityLog[]
  taskAssets   TaskAsset[]

  @@index([boardId])
  @@index([status])
  @@index([assigneeId])
  @@index([parentTaskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Attachment {
  id           String        @id @default(cuid())
  taskId       String
  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  filename     String
  mimeType     String
  size         Int
  createdAt    DateTime      @default(now())
  evidenceKind EvidenceKind?
  capturedAt   DateTime?
  latitude     Float?
  longitude    Float?

  @@index([taskId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([taskId])
  @@index([organizationId])
  @@index([createdAt])
}

model Asset {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  code            String
  /// Código del catálogo AssetCategoryOption de la organización.
  category        String
  /// Código del catálogo AssetStatusOption de la organización.
  status          String         @default("OPERATIONAL")
  location        String?
  maintenanceDate DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  taskLinks       TaskAsset[]
  history         AssetHistory[]
  photos          AssetPhoto[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([category])
  @@index([status])
}

model AssetCategoryOption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  color          String       @default("#6750A4")
  icon           String       @default("inventory_2")
  isDefault      Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, sortOrder])
}

model AssetStatusOption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  color          String       @default("#6750A4")
  isDefault      Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, sortOrder])
}

model TaskAsset {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, assetId])
  @@index([taskId])
  @@index([assetId])
}

model AssetHistory {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([createdAt])
}

model AssetPhoto {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([assetId])
}
